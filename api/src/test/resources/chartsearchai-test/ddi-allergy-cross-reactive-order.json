{
 "metadata": {
  "note": "Verbatim DDInter 2.0 slice for ADR Decision 167, taken unedited from the shipped KB in the shipped file's own order: the rows for Acetylsalicylic acid and Clopidogrel (shipped indices 1112 and 1633), every shipped interaction row falling wholly inside them, and the mechanism entries those rows reference. Both share ATC subgroup B01AC, so a recorded clopidogrel allergy raises a same-class contraindication chip about patient 7's standing aspirin order: a recorded allergy, but not to the drug she is prescribed."
 },
 "mechanisms": {
  "2810": {
   "text": "Clopidogrel has been shown to potentiate the inhibition of platelet aggregation due to aspirin. The safety of chronic administration of aspirin or other salicylates with clopidogrel has not been established.",
   "categories": [
    "synergistic_effect"
   ]
  },
  "-1": {
   "text": null,
   "categories": []
  }
 },
