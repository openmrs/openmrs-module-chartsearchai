<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
		"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.openmrs.module.chartsearchai.model">

	<class name="ChartSearchAuditLog" table="chartsearchai_audit_log">

		<id name="auditLogId" column="audit_log_id" type="int">
			<generator class="native"/>
		</id>

		<many-to-one name="user" class="org.openmrs.User" column="user_id" not-null="true"/>

		<many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="true"/>

		<property name="question" column="question" type="text" not-null="true"/>

		<property name="answer" column="answer" type="text" not-null="true"/>

		<property name="referenceCount" column="reference_count" type="java.lang.Integer"/>

		<property name="referenceSliceRecords" column="reference_slice_records" type="java.lang.Integer"/>

		<property name="referenceSliceChars" column="reference_slice_chars" type="java.lang.Integer"/>

		<property name="searchMode" column="search_mode" type="string" length="20" not-null="true"/>

		<property name="responseTimeMs" column="response_time_ms" type="java.lang.Long"/>

		<property name="inputTokens" column="input_tokens" type="java.lang.Integer"/>

		<property name="outputTokens" column="output_tokens" type="java.lang.Integer"/>

		<property name="dateCreated" column="date_created" type="timestamp" not-null="true"/>

		<property name="rating" column="rating" type="string" length="10"/>

		<property name="feedbackComment" column="feedback_comment" type="text"/>

		<property name="providerId" column="provider_id" type="string" length="64"/>

		<property name="providerMode" column="provider_mode" type="string" length="64"/>

		<property name="conversationUuid" column="conversation_uuid" type="string" length="38"/>

		<property name="requestId" column="request_id" type="string" length="100"/>

	</class>

</hibernate-mapping>
