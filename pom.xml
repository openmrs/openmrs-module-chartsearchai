<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.openmrs.module</groupId>
	<artifactId>chartsearchai</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Chart Search AI Module</name>
	<description>AI-powered chart search module for OpenMRS</description>

	<url>https://wiki.openmrs.org/display/docs/Chart+Search+AI+Module</url>

	<organization>
		<name>OpenMRS</name>
		<url>https://openmrs.org</url>
	</organization>

	<scm>
		<connection>scm:git:git@github.com:openmrs/openmrs-module-chartsearchai.git</connection>
		<developerConnection>scm:git:git@github.com:openmrs/openmrs-module-chartsearchai.git</developerConnection>
		<url>https://github.com/openmrs/openmrs-module-chartsearchai</url>
	</scm>

	<modules>
		<module>api</module>
		<module>omod</module>
	</modules>

	<properties>
		<openmrsPlatformVersion>2.9.0-SNAPSHOT</openmrsPlatformVersion>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.openmrs.api</groupId>
				<artifactId>openmrs-api</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>jar</type>
				<scope>provided</scope>
			</dependency>

			<dependency>
				<groupId>org.openmrs.web</groupId>
				<artifactId>openmrs-web</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>jar</type>
				<scope>provided</scope>
			</dependency>

			<dependency>
				<groupId>org.openmrs.api</groupId>
				<artifactId>openmrs-api</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>

			<dependency>
				<groupId>org.openmrs.web</groupId>
				<artifactId>openmrs-web</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>

			<dependency>
				<groupId>org.openmrs.test</groupId>
				<artifactId>openmrs-test</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>pom</type>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<!-- Pinned because this build's correctness now depends on ONE plugin parameter being
					     honoured. <compilerArgs> arrived in maven-compiler-plugin 3.1; pin an earlier version
					     and Maven silently ignores the element as an unknown parameter, with no diagnostic —
					     measured: version 2.5.1 here, a dead javadoc reference planted in omod/src/main/java,
					     `mvn -o clean install` exit 0 and not one `reference not found` printed. Unpinned, the
					     version is whatever Maven's super-POM supplies and so moves with the developer's Maven
					     install. JavadocReferenceGuardTest requires this element and requires it to be at
					     least 3.1. A ${...} property declared in these POMs is resolved first, so
					     parameterising this version is fine — measured: ${compilerPluginVersion} with the
					     property here builds green, and one resolving to 2.5.1 is refused with the floor's
					     own message. A version the check cannot evaluate is reported as UNREADABLE and never
					     as too old; RELEASE and LATEST never get that far, Maven refusing them itself
					     ("must be a valid version but is 'RELEASE'"). -->
					<version>3.13.0</version>
					<configuration>
						<target>${maven.compiler.target}</target>
						<source>${maven.compiler.source}</source>
						<encoding>${project.build.sourceEncoding}</encoding>
						<!-- Every javadoc reference in this module must resolve, and this is what makes one that
						     does not a build failure rather than plain text that reads as authoritative. It is on
						     javac rather than in a maven-javadoc-plugin CI profile, and it is the `reference`
						     group rather than a wider one; that group covers more than {@link}, so a mistyped
						     @param is an error here too.

						     Do not remove or narrow this without reading docs/adr.md, Decision 75, which carries
						     the measurements, the alternatives already refused and what the check still cannot
						     see. JavadocReferenceGuardTest is what stops it being removed with a green build,
						     and it asserts this POSITION and not merely the argument: declared in a child pom
						     instead, the flag gates one module and the other compiles ungated.

						     What that guard and its omod-side sibling are worth is checkable and bounded:
						     between them they hold the flag's presence, what the declared arguments DO (asked
						     of the compiler), the plugin version that has to honour them, and the assertion
						     that each module's tests are in the build — stated two different ways from two
						     modules, so one edit rarely defeats both. They do NOT enumerate every position
						     from which Maven can change javac's arguments or drop a module's tests: every
						     review round of #262 so far has found one more, and every absolute claim
						     published about it — one in the omod-side check's javadoc, one in Decision 75,
						     and that decision's own QUIET enumeration — has been falsified by a later
						     round. What is
						     claimed is that silencing this gate costs more and shows up on output a
						     maintainer sees — a printed doclint error, a `Failures:` line beside exit 0, a
						     reactor test total that drops — not that it cannot be silenced. Do NOT grep a log
						     for "No tests to run" to check the gate ran: that string belongs to a child-pom
						     shape the guards refuse. Re-measured: a root-pom test-skip property prints each
						     module's surefire banner with "Tests are skipped." under it, and the <executions>
						     spelling in the root's <build><plugins> prints no surefire output at all.

						     Round 12's shape is the one that reads least like a dropped total, and it is
						     why the QUIET enumeration was wrong: a surefire SELECTION in THIS pom's
						     <properties> whose value removes both guards from the run is refused by nothing
						     that runs, because the refusal is written in the tests it drops. Measured, JDK
						     21: <surefire.excludes>**/JavadocReference*Test.java</surefire.excludes> here
						     gives `mvn -o clean install` exit 0, BUILD SUCCESS, `grep -c JavadocReference`
						     over the whole log zero, and a reactor total short by only those guards' tests.
						     It does NOT on its own reinstate the defect: this <arg> is still on javac, and
						     the same edit with a dead pointer in api/src/main/java gives exit 1 with
						     "reference not found" printed. It removes the guard on what is INSIDE this
						     <compilerArgs>, so one further <arg> here is the second edit that silences
						     doclint. Decision 75 carries the rest, and what turned out not to be quiet. -->
						<compilerArgs>
							<arg>-Xdoclint:reference</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.openmrs.maven.plugins</groupId>
					<artifactId>maven-openmrs-plugin</artifactId>
					<version>1.0.1</version>
				</plugin>
				<!-- No <excludedGroups>: this pinned an `eval` JUnit tag that existed nowhere in the
				     repo (#179), so it matched nothing and only implied a boundary the build did not
				     enforce. Restoring the boundary would mean tagging the four *EvalTest suites
				     out of CI, which deletes coverage rather than restoring anything: three of them
				     are model-free, fast, and carry live assertions (CitationEvalTest's
				     avgF1 >= 0.8, DrugSafetyEvalTest's expected warning types, AbsentDataEvalTest's
				     stopword check). The fourth, PromptInjectionEvalTest, is the only one needing an
				     LLM, and it already opts itself out via a JUnit assumption on
				     -Dchartsearchai.prompt.injection.test — so the exclusion this property implied
				     was not needed for it either. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.5</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<repositories>
		<repository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://mavenrepo.openmrs.org/public</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://mavenrepo.openmrs.org/public</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<distributionManagement>
		<repository>
			<id>openmrs-repo-modules</id>
			<name>OpenMRS Modules</name>
			<url>https://mavenrepo.openmrs.org/modules</url>
		</repository>
		<snapshotRepository>
			<id>openmrs-repo-snapshots</id>
			<name>OpenMRS Snapshots</name>
			<url>https://mavenrepo.openmrs.org/snapshots</url>
		</snapshotRepository>
	</distributionManagement>
</project>
