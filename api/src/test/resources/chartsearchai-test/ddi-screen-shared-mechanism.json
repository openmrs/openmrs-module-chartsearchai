 "metadata": {
  "note": "Verbatim DDInter slice for ADR Decision 190: an interaction screen of her own orders where one drug relates to two of them by one mechanism at one rating (ibuprofen and celecoxib, each against prednisone and dexamethasone - the corticosteroid and NSAID row). Rows are field-for-field their rows in the shipped ddi-knowledge-base.json, in KB order, and the interaction rows are every KB pair among these four drugs, with the mechanisms they cite."
 },
 "mechanisms": {
  "-1": {
   "text": null,
   "categories": []
  },
  "3212": {
   "text": "The combined use of corticosteroids and nonsteroidal anti-inflammatory drugs (NSAIDs) may increase the potential for serious gastrointestinal (GI) toxicity, including inflammation, bleeding, ulceration, and perforation.",
   "categories": [
    "synergistic_effect"
   ]
  },
  "3927": {
   "text": "Concomitant use of COX-2 inhibitors with other nonsteroidal anti-inflammatory drugs (NSAIDs) may increase the potential for serious gastrointestinal toxicity including inflammation, bleeding, ulceration, and perforation. The risk is dependent on both dosage and duration of therapy.",
   "categories": [
    "synergistic_effect"
   ]
  }
 },
